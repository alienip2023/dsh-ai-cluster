{
  "name": "dsh-ai-cluster",
  "version": "0.4.14",
  "type": "module",
  "description": "AI 集群控制 / AI Cluster Control：把几台电脑连成一张 AI 网络，主控派任务、副机执行、统一面板、模型与记忆统一配置。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alienip2023/dsh-ai-cluster.git"
  },
  "bugs": {
    "url": "https://github.com/alienip2023/dsh-ai-cluster/issues"
  },
  "homepage": "https://github.com/alienip2023/dsh-ai-cluster#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "ai-agent",
    "agent",
    "multi-agent",
    "remote-agent",
    "remote-execution",
    "task-automation",
    "self-hosted",
    "zero-dependency",
    "handoff",
    "artifact",
    "subagent-provider",
    "mesh",
    "discovery",
    "unified"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./hub": "./lib/hub/index.js",
    "./worker": "./lib/node/index.js",
    "./protocol": "./lib/protocol.js",
    "./pairing": "./lib/pairing.js",
    "./relay": "./lib/relay.js",
    "./setup": "./lib/setup.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./profiles/hub.cordis.yml": "./profiles/hub.cordis.yml",
    "./profiles/worker.cordis.yml": "./profiles/worker.cordis.yml"
  },
  "main": "./lib/index.js",
  "bin": {
    "dsh-remote-relay": "bin/dsh-remote-relay.js",
    "dsh-remote-setup": "bin/dsh-remote-setup.js"
  },
  "files": [
    "lib",
    "src/compat/dual-provide.js",
    "src/compat/ra-names.js",
    "bin",
    "deploy",
    "docs",
    "profiles",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "KNOWN-ISSUES.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "ssh2": "^1.16.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js test/phase1/*.test.js",
    "check:docs": "node scripts/check-doc-drift.mjs",
    "check:packaging": "node scripts/check-packaging.mjs",
    "check:release": "node scripts/check-release-reachability.mjs",
    "lint": "eslint .",
    "check": "npm run check:packaging && npm run check:docs && npm run diag:inject && npm test",
    "diag:inject": "node scripts/diag-inject.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
